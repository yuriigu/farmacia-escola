# Use este arquivo ao rodar o frontend SEM Docker.
# Para Docker, use o .env da raiz do projeto.
# Copie para frontend/.env.local antes de rodar.

# URL base do Backend acessada pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL da API para rewrites server-side do Next.js
INTERNAL_API_URL=http://localhost:3001