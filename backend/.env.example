# Use este arquivo ao rodar o backend SEM Docker.
# Para Docker, use o .env da raiz do projeto.
# Copie para backend/.env antes de rodar.

DATABASE_URL=file:./prisma/dev.db
FRONTEND_URL=http://localhost:3000
JWT_SECRET=preencha-com-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development

# O script de seed (npm run db:seed) cria usuarios com senhas padrao fracas
# (admin123, farm123, ...). Ele e bloqueado quando NODE_ENV=production.
# Defina a variavel abaixo como true apenas em ambientes de demonstracao.
# SEED_ALLOW_INSECURE_PASSWORDS=false