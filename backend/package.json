{
  "name": "farmacia-escola-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx ts-node src/seed/seed.ts",
    "knip": "knip",
    "knip:fix": "knip --fix --fix-type exports",
    "knip:deps": "knip --dependencies",
    "knip:files": "knip --files",
    "knip:exports": "knip --exports",
    "knip:json": "knip --reporter json > knip-report.json",
    "knip:verbose": "knip --reporter verbose"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "deepmerge-ts": "^8.0.2",
    "knip": "^6.34.0",
    "nodemon": "^3.1.9",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2",
    "vitest": "^3.0.0"
  }
}
