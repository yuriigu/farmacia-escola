generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        String   @default("ALUNO")
  registerDoc String?  @unique
  phone       String?
  active      Boolean  @default(true)
  permissions String?
  createdAt   DateTime @default(now())

  disposals      Disposal[]
  patient        Patient?
  activityLogs   ActivityLog[]
  scheduleSlots  ScheduleSlot[]
  movements      StockMovement[]
  dispensedAppointments Appointment[] @relation("DispensedAppointments")

  @@index([role])
  @@index([active])
  @@index([role, active])
  @@index([name])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@index([entity, createdAt])
  @@index([userId, createdAt])
}

model Patient {
  id        Int       @id @default(autoincrement())
  name      String
  cpf       String    @unique
  phone     String?
  birthDate DateTime?
  address   String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  userId    Int?      @unique

  user         User?        @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@index([deletedAt])
  @@index([name])
  @@index([deletedAt, name])
  @@index([cpf, deletedAt])
}

model Medicine {
  id               Int       @id @default(autoincrement())
  name             String
  activeIngredient String?
  dosage           String?
  dosageValue      Float?
  dosageUnit       String?
  minQuantity      Float     @default(0)
  accessibleDesc   String?
  category         String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  batches          StockBatch[]
  appointmentItems AppointmentItem[]

  @@index([deletedAt])
  @@index([name])
  @@index([deletedAt, name])
  @@index([category])
  @@index([category, deletedAt])
}

model StockBatch {
  id                Int       @id @default(autoincrement())
  medicineId        Int
  batchNumber       String
  currentQuantity   Int       @default(0)
  expirationDate    DateTime
  manufacturingDate DateTime?
  supplier          String    @default("Não informado")
  isBlocked         Boolean   @default(false)
  blockReason       String?
  receivedAt        DateTime  @default(now())

  medicine          Medicine        @relation(fields: [medicineId], references: [id])
  disposals         Disposal[]
  movements         StockMovement[]
  appointmentItems  AppointmentItem[]
  appointments      Appointment[]

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expirationDate])
  @@index([isBlocked])
  @@index([medicineId, expirationDate])
  @@index([expirationDate, currentQuantity])
}

model Disposal {
  id              Int      @id @default(autoincrement())
  batchId         Int
  userId          Int
  quantity        Int
  reason          String
  notes           String?
  date            DateTime @default(now())
  status          String   @default("DISPOSED")
  revertReason    String?
  reverted        Boolean  @default(false)

  batch StockBatch @relation(fields: [batchId], references: [id])
  user  User       @relation(fields: [userId], references: [id])

  @@index([batchId])
  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([batchId, status])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  batchId   Int
  type      String
  quantity  Int
  notes     String?
  createdAt DateTime @default(now())
  userId    Int?

  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id])

  @@index([batchId])
  @@index([type])
  @@index([createdAt])
  @@index([batchId, createdAt])
  @@index([batchId, type])
}

model ScheduleSlot {
  id           Int      @id @default(autoincrement())
  date         DateTime
  timeSlot     String
  maxCapacity  Int      @default(5)
  active       Boolean  @default(true)
  assignedToId Int?
  createdAt    DateTime @default(now())

  assignedTo  User?         @relation(fields: [assignedToId], references: [id])
  appointments Appointment[]

  @@unique([date, timeSlot])
  @@index([date])
  @@index([active])
  @@index([active, date])
  @@index([assignedToId])
}

model Appointment {
  id                Int       @id @default(autoincrement())
  patientId         Int
  scheduledDate     DateTime
  scheduledTime     String?
  slotId            Int?
  status            String    @default("PENDING")
  notes             String?
  batchId           Int?
  dispensedByUserId Int?
  dispensedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient         Patient           @relation(fields: [patientId], references: [id])
  slot            ScheduleSlot?     @relation(fields: [slotId], references: [id])
  batch           StockBatch?       @relation(fields: [batchId], references: [id])
  dispensedByUser User?             @relation("DispensedAppointments", fields: [dispensedByUserId], references: [id])
  items           AppointmentItem[]

  @@index([scheduledDate, status])
  @@index([patientId])
  @@index([status])
  @@index([slotId, status])
  @@index([patientId, status])
  @@index([scheduledDate])
  @@index([createdAt])
}

model AppointmentItem {
  id             Int         @id @default(autoincrement())
  appointmentId  Int
  medicineId     Int
  quantity       Int
  batchId        Int?

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  medicine    Medicine    @relation(fields: [medicineId], references: [id])
  batch       StockBatch? @relation(fields: [batchId], references: [id])

  @@index([appointmentId])
  @@index([medicineId])
  @@index([batchId])
}