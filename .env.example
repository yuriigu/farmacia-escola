# Copie este arquivo para .env antes de usar Docker Compose.
# Nao commite o arquivo .env real.

# Backend
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=file:./prisma/dev.db
JWT_SECRET=preencha-com-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d

# Frontend no navegador
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend dentro do container, para rewrites server-side
INTERNAL_API_URL=http://backend:3001

# Polling ajuda o hot reload quando o projeto esta montado em volume Docker
WATCHPACK_POLLING=true